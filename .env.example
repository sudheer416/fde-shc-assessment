# Ingestion target: use local Express mock server for local development.
API_URL=http://localhost:4000/v1/patients
API_TOKEN=local-dev-token
INPUT_FILE=./data/patients.csv
FAILED_RECORDS_FILE=./output/failed_records.json
BATCH_SIZE=100
MAX_REQUESTS_PER_SECOND=5
MAX_RETRIES=5
INITIAL_BACKOFF_MS=500
REQUEST_TIMEOUT_MS=30000

# Local mock API settings
MOCK_API_PORT=4000
MOCK_API_TOKEN=local-dev-token
MOCK_MAX_REQUESTS_PER_SECOND=5
# Optional retry testing: first N API requests return MOCK_FAILURE_STATUS, then succeed.
MOCK_FAIL_FIRST_REQUESTS=0
MOCK_FAILURE_STATUS=500
